#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$PROJECT_ROOT/lib/version.sh"

usage() {
cat <<EOF
ArchForge v${ARCHFORGE_VERSION}

Usage:

    ./archforge backup <directory>

    ./archforge restore <directory-or-archive> [-y|--yes]

    ./archforge verify <directory>

    ./archforge doctor

    ./archforge version

EOF
}

case "${1:-}" in

backup)
    shift
    exec "$PROJECT_ROOT/backup.sh" "$@"
    ;;

restore)
    shift
    exec "$PROJECT_ROOT/restore.sh" "$@"
    ;;

verify)
    shift
    exec "$PROJECT_ROOT/verify.sh" "$@"
    ;;

doctor)
    shift
    exec "$PROJECT_ROOT/doctor.sh" "$@"
    ;;

version|-v|--version)
    echo "ArchForge v${ARCHFORGE_VERSION}"
    ;;

-h|--help|help)
    usage
    ;;

*)
    usage
    exit 1
    ;;

esac
