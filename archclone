#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/lib/version.sh" ]]; then
    PROJECT_ROOT="$SCRIPT_DIR"
elif [[ -f "/usr/lib/archclone/lib/version.sh" ]]; then
    PROJECT_ROOT="/usr/lib/archclone"
else
    echo "Error: Could not locate ArchClone installation." >&2
    exit 1
fi

source "$PROJECT_ROOT/lib/version.sh"

usage() {
cat <<EOF
ArchClone v${ARCHCLONE_VERSION}

Usage:

    ./archclone backup <directory>

    ./archclone restore <directory-or-archive> [-y|--yes]

    ./archclone verify <directory>

    ./archclone doctor

    ./archclone version

EOF
}

case "${1:-}" in

backup)
    shift
    exec "$PROJECT_ROOT/backup.sh" "$@"
    ;;

restore)
    shift
    exec "$PROJECT_ROOT/restore.sh" "$@"
    ;;

verify)
    shift
    exec "$PROJECT_ROOT/verify.sh" "$@"
    ;;

doctor)
    shift
    exec "$PROJECT_ROOT/doctor.sh" "$@"
    ;;

version|-v|--version)
    echo "ArchClone v${ARCHCLONE_VERSION}"
    ;;

-h|--help|help)
    usage
    ;;

*)
    usage
    exit 1
    ;;

esac
